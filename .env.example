# ---------------------------------------------------------------------------
# SIIPI — variables d'environnement à la racine du projet.
# Copiez ce fichier vers .env et complétez-le. .env n'est JAMAIS versionné.
# ---------------------------------------------------------------------------

# Mot de passe du compte PostgreSQL de la plateforme.
# Développement : la valeur par défaut du docker-compose suffit.
# Déploiement  : obligatoire, et généré aléatoirement (openssl rand -base64 24).
DB_PASSWORD="siipi_dev_password"

# Secret de signature des jetons d'authentification (JWT).
# Déploiement : obligatoire et fort — openssl rand -hex 32
# L'API refuse de démarrer en production avec la valeur de développement.
JWT_SECRET="dev_only_change_me_before_any_real_deployment"

# Secret maître des empreintes de CIN des pré-collecteurs (lot 16.1).
# Un CIN compte 8 chiffres : son empreinte ne protège que si ce secret reste
# hors de la base. Déploiement : obligatoire et fort — openssl rand -hex 32.
# Le changer arrête le dédoublonnage aux inscriptions faites sous l'ancien.
SIIPI_SECRET_IDENTITES="dev_only_secret_identites_a_remplacer"

# Clé des secrets du connecteur GPS (lot 17.4a) : le jeton d'un fournisseur et
# le secret de son webhook sont chiffrés avec elle avant d'entrer en base.
# Déploiement : obligatoire et fort — openssl rand -hex 32. La changer rend
# illisibles les jetons enregistrés : chaque commune les ressaisit.
SIIPI_SECRET_GPS="dev_only_secret_gps_a_remplacer"

# Origine autorisée à appeler l'API depuis un navigateur (front-end), en
# développement. En production, le compose la déduit de SIIPI_DOMAINE.
CORS_ORIGIN="http://localhost:3000"

# --- HTTPS (chantier P, lot P4 ; docker-compose.prod.yml) ---------------------
# Le nom du serveur, tel que les navigateurs l'appelleront.
SIIPI_DOMAINE=""
# Le certificat : une adresse électronique (Let's Encrypt, renouvelé seul ; le
# port 80 doit être joignable depuis internet), ou
# "/certificats/cert.pem /certificats/cle.pem" (celui de la DSI, déposé dans
# ./certificats), ou "internal" pour un essai sur un poste.
SIIPI_TLS=""

# Adresse de l'API vue depuis le navigateur du poste client.
VITE_API_URL="http://localhost:4000"

# --- Sauvegardes (chantier P, lot P2 ; docker-compose.prod.yml) ---------------
# Les clés PUBLIQUES age, séparées par une virgule : une par personne de la FNCT
# qui garde la clé privée correspondante hors ligne (age-keygen -o cle.txt sur
# son propre poste ; la ligne « public key: age1… » va ici). Sans clé, chaque
# sauvegarde échoue : rien ne s'écrit jamais en clair.
SAUVEGARDE_DESTINATAIRES=""
# La copie hors du serveur : un chemin monté, ou « distant:dossier » décrit dans
# sauvegarde.env (RCLONE_CONFIG_*). Vide : les sauvegardes restent sur le serveur.
SAUVEGARDE_DESTINATION=""
# L'heure de la sauvegarde, heure de Tunis.
SAUVEGARDE_HEURE="02:30"

# --- Supervision (chantier P, lot P5 ; docker-compose.prod.yml) ---------------
# Les adresses qui reçoivent les alertes, séparées par une virgule. Le courriel
# part par le serveur SMTP de l'API (SMTP_*). Vide : aucune alerte ne part, et
# l'écran « État de l'exploitation » le dit.
SUPERVISION_DESTINATAIRES=""

# --- Déploiement (chantier P, lot P6 ; docs/exploitation/) ---------------------
# Le nom de l'instance : celui des conteneurs et des volumes (siipi_api,
# siipi_siipi_postgres_data…). Une instance de formation en porte un autre.
SIIPI_INSTANCE="siipi"
