{
  "name": "siipi-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Front-end du Système d'Information Intelligent pour la Propreté Intercommunale (FNCT)",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
