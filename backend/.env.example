# Base de données PostgreSQL (voir docker-compose.yml à la racine du projet)
DATABASE_URL="postgres://siipi_admin:change_me_strong_password@localhost:5432/siipi_national"

# Secret utilisé pour signer les tokens JWT — À CHANGER en production
# Générer une valeur forte, par ex. avec : openssl rand -hex 32
JWT_SECRET="dev_only_change_me_before_any_real_deployment"

# Durée de validité du token d'accès
JWT_EXPIRES_IN="8h"

# Port d'écoute de l'API
PORT=4000

# Origine autorisée pour les requêtes CORS depuis le front-end (Vite dev server)
CORS_ORIGIN="http://localhost:3000"

# Notifications push (Jalon 2, lot 1) — paire de clés VAPID qui identifie le
# serveur auprès des navigateurs, comme un certificat auto-signé : ce n'est
# PAS un compte chez un fournisseur, rien à payer, rien à souscrire.
# Ci-dessous, une paire de développement générée avec `npm run vapid:generer` —
# À REMPLACER avant tout déploiement réel, par la même commande relancée une
# fois, une bonne fois pour toutes (des clés qui changent invalident les
# abonnements déjà enregistrés par les navigateurs).
VAPID_PUBLIC_KEY="BOM754xPkQeWDMf-RTg7bZ8cACy-SlN2yEO54w-W-lHpT0hlkpkY6BHD1UO7fufpFf0UqOEamqWzL5r1qSrKvOM"
VAPID_PRIVATE_KEY="z55dT82Eu7bdDSK7kLCLM-4wccgUi2I-CF0xaVF1cN8"
VAPID_SUBJECT="mailto:contact@fnct.tn"
