# Base de données PostgreSQL (voir docker-compose.yml à la racine du projet)
DATABASE_URL="postgres://siipi_admin:change_me_strong_password@localhost:5432/siipi_national"

# Secret utilisé pour signer les tokens JWT — À CHANGER en production
# Générer une valeur forte, par ex. avec : openssl rand -hex 32
JWT_SECRET="dev_only_change_me_before_any_real_deployment"

# Durée de validité du token d'accès
JWT_EXPIRES_IN="8h"

# Port d'écoute de l'API
PORT=4000

# Origine autorisée pour les requêtes CORS depuis le front-end (Vite dev server)
CORS_ORIGIN="http://localhost:3000"
