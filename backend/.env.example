# Base de données PostgreSQL — pour lancer l'API HORS conteneur (npm run dev
# sur le poste), contre la base du docker-compose.yml, qui publie le port 5432.
# Le mot de passe est celui du Compose : DB_PASSWORD du .env racine, à défaut
# « siipi_dev_password ». Ce fichier en citait un autre, que la base ne
# connaissait pas : copié tel quel, il rendait l'API incapable de se connecter.
# Dans les conteneurs, rien à faire : le Compose fournit DATABASE_URL lui-même.
DATABASE_URL="postgres://siipi_admin:siipi_dev_password@localhost:5432/siipi_national"

# Secret utilisé pour signer les tokens JWT — À CHANGER en production
# Générer une valeur forte, par ex. avec : openssl rand -hex 32
JWT_SECRET="dev_only_change_me_before_any_real_deployment"

# Secret maître des empreintes de CIN des pré-collecteurs (lot 16.1).
# Un CIN compte 8 chiffres : son empreinte ne protège que si ce secret reste
# hors de la base. Déploiement : obligatoire et fort — openssl rand -hex 32.
# Le changer arrête le dédoublonnage aux inscriptions faites sous l'ancien.
SIIPI_SECRET_IDENTITES="dev_only_secret_identites_a_remplacer"

# Durée de validité du token d'accès
JWT_EXPIRES_IN="8h"

# Port d'écoute de l'API
PORT=4000

# Origine autorisée pour les requêtes CORS depuis le front-end (Vite dev server)
CORS_ORIGIN="http://localhost:3000"

# Notifications push (Jalon 2, lot 1) — paire de clés VAPID qui identifie le
# serveur auprès des navigateurs, comme un certificat auto-signé : ce n'est
# PAS un compte chez un fournisseur, rien à payer, rien à souscrire.
# Ci-dessous, une paire de développement générée avec `npm run vapid:generer` —
# À REMPLACER avant tout déploiement réel, par la même commande relancée une
# fois, une bonne fois pour toutes (des clés qui changent invalident les
# abonnements déjà enregistrés par les navigateurs).
VAPID_PUBLIC_KEY="BOM754xPkQeWDMf-RTg7bZ8cACy-SlN2yEO54w-W-lHpT0hlkpkY6BHD1UO7fufpFf0UqOEamqWzL5r1qSrKvOM"
VAPID_PRIVATE_KEY="z55dT82Eu7bdDSK7kLCLM-4wccgUi2I-CF0xaVF1cN8"
VAPID_SUBJECT="mailto:contact@fnct.tn"

# Le courriel (v0.15.47) : mot de passe provisoire d'un compte, notifications
# aux citoyens qui l'ont demandé. Le serveur SMTP est celui que désigne
# l'exploitant (hébergement en Tunisie) ; SIIPI ne s'abonne à aucun service
# d'envoi. SMTP_HOST vide : rien ne part, les mots de passe provisoires
# s'affichent au cadre, et l'écran des paramètres nationaux le dit.
#   SMTP_SECURITE : starttls (port 587), tls (port 465), aucune (réseau interne seulement)
# Le mot de passe du serveur ne sort jamais de la configuration : aucune route
# ne le rend, aucun écran ne le saisit.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURITE="starttls"
SMTP_UTILISATEUR=""
SMTP_MOT_DE_PASSE=""
COURRIEL_EXPEDITEUR="SIIPI <ne-pas-repondre@siipi.tn>"
# L'adresse du portail, écrite dans les courriels (lien de connexion, lien vers une publication).
COURRIEL_URL_PORTAIL="http://localhost:3000"
