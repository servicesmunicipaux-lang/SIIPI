{
  "name": "siipi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST SIIPI - Système d'Information Intelligent pour la Propreté Intercommunale (FNCT / ANGeD)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "import:boundaries": "tsx seed/importBoundaries.ts",
    "lint": "tsc --noEmit",
    "migrate:prod": "node dist/src/migrate.js",
    "seed:prod": "node dist/seed/seed.js",
    "test:cloisonnement": "bash tests/cloisonnement.sh",
    "test:audit": "bash tests/audit.sh",
    "test": "npm run verifier:contrat && bash tests/cloisonnement.sh && bash tests/audit.sh && bash tests/suppression.sh",
    "test:suppression": "bash tests/suppression.sh",
    "verifier:contrat": "tsx src/openapi/verifierContrat.ts",
    "openapi:export": "tsx src/openapi/exporter.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "swagger-ui-dist": "^5.32.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-dist": "^3.30.6",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
  }
}
