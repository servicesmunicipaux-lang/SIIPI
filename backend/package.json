{
  "name": "siipi-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "API REST SIIPI - Système d'Information Intelligent pour la Propreté Intercommunale (FNCT / ANGeD)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "seed:dar-chaabane": "tsx seed/darChaabane.ts",
    "seed:parc": "tsx seed/parcDarChaabane.ts",
    "seed:personnel": "tsx seed/personnelDarChaabane.ts",
    "seed:communication": "tsx seed/communicationDarChaabane.ts",
    "import:boundaries": "tsx seed/importBoundaries.ts",
    "lint": "tsc --noEmit",
    "migrate:prod": "node dist/src/migrate.js",
    "seed:prod": "node dist/seed/seed.js",
    "test:cloisonnement": "sh tests/executer.sh cloisonnement",
    "test:audit": "sh tests/executer.sh audit",
    "test": "npm run verifier:contrat && sh tests/executer.sh cloisonnement && sh tests/executer.sh audit && sh tests/executer.sh suppression && sh tests/executer.sh observatoire && sh tests/executer.sh circuits && sh tests/executer.sh prestataires && sh tests/executer.sh citoyen && sh tests/executer.sh enlevements && sh tests/executer.sh decoupage && sh tests/executer.sh periode && sh tests/executer.sh intercommunal && sh tests/executer.sh module2 && sh tests/executer.sh comptes && sh tests/executer.sh module3 && sh tests/executer.sh module4 && sh tests/executer.sh module5 && sh tests/executer.sh module6 && sh tests/executer.sh fichiers && sh tests/executer.sh suggestions && sh tests/executer.sh rapports",
    "test:suppression": "sh tests/executer.sh suppression",
    "verifier:contrat": "tsx src/openapi/verifierContrat.ts",
    "openapi:export": "tsx src/openapi/exporter.ts",
    "test:observatoire": "sh tests/executer.sh observatoire",
    "test:circuits": "sh tests/executer.sh circuits",
    "test:prestataires": "sh tests/executer.sh prestataires",
    "test:citoyen": "sh tests/executer.sh citoyen",
    "test:enlevements": "sh tests/executer.sh enlevements",
    "import:decoupage": "tsx seed/importDecoupage.ts",
    "import:decoupage:prod": "node dist/seed/importDecoupage.js",
    "test:decoupage": "sh tests/executer.sh decoupage",
    "test:periode": "sh tests/executer.sh periode",
    "test:intercommunal": "sh tests/executer.sh intercommunal",
    "test:module2": "sh tests/executer.sh module2",
    "test:comptes": "sh tests/executer.sh comptes",
    "test:module3": "sh tests/executer.sh module3",
    "test:module4": "sh tests/executer.sh module4",
    "test:module5": "sh tests/executer.sh module5",
    "test:module6": "sh tests/executer.sh module6",
    "test:fichiers": "sh tests/executer.sh fichiers",
    "test:suggestions": "sh tests/executer.sh suggestions",
    "test:rapports": "sh tests/executer.sh rapports"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "swagger-ui-dist": "^5.32.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-dist": "^3.30.6",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
  }
}
